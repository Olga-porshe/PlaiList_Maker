<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Style1" parent="Widget.MaterialComponents.ActionBar.Primary">

        <item name="android:layout_gravity" >center</item>
        <item name="android:background">@drawable/image_button_background</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/ys_text_bold</item>

    </style>

    <style name="Style2" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="android:background">@drawable/image_button_background</item>

    </style>

    <style name="Widget.PlaylistMaker.Toolbar" parent="Widget.MaterialComponents.ActionBar.Primary">

        <item name="elevation">0dp</item>

    </style>

    <style name="SettingsNew">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:scaleType">centerCrop</item>


        <item name="android:background">?attr/colorSurface</item>


        <item name="android:tint">?attr/colorOnSurface</item>


        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>

    </style>



</resources>